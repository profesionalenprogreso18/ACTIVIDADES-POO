//Ejercicio 1:
package mx.unam.fesa.ico;

import java.awt.Button;
import java.awt.FlowLayout;
import java.awt.Frame;
import java.awt.TextField;

public class Ventana extends Frame {

    Button boton1;
    TextField texto;
    FlowLayout layout;

    public Ventana(){
        this("Ventana", 400, 300);
    }

    public Ventana(String titulo, int ancho, int alto){
        super(titulo);
        setSize(ancho, alto);
        boton1 = new Button("Botón 1");
        texto = new TextField(20);

        layout = new FlowLayout();
        this.setLayout(layout);

        this.add(boton1);
        this.add(texto);

        this.setVisible(true);
    }

    static void main(String[] args) {
        Ventana ventana1 = new Ventana("Mi interfa gráfica", 400, 200);
    }
}





//Ejercicio 2:
package mx.unam.fesa.ico;

import java.awt.*;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class Ventana2 extends Frame {


    Button btn = new Button("Norte");
    Button btn2 = new Button("Sur");
    Button btn3 = new Button("Este");
    Button btn4 = new Button("Oeste");

    public Ventana2(){
        super("Ventana con eventos");
        setSize(400, 300);
        setResizable(false);
        setLayout(new BorderLayout());

        add(BorderLayout.NORTH, btn);
        add(BorderLayout.SOUTH, btn2);
        add(BorderLayout.WEST, btn4);
        add(BorderLayout.EAST, btn3);

        addWindowListener(
                new WindowAdapter() {
                    public void windowClosing(WindowEvent e) {
                        System.exit(0);
                    }
                }
        );

        setVisible(true);
    }

    static void main(String[] args) {
        new Ventana2();
    }
}





//Ejercicio 3:
package mx.unam.fesa.ico;

import java.awt.*;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class Ventana3 extends Frame {


    Button btn = new Button("Presioname");
    Button btn2 = new Button("En segundo lugar a este");
    Button btn3 = new Button("Después a este");
    Button btn4 = new Button("Por último a este");

    public Ventana3(){
        super("Ventana con eventos");
        setSize(400, 300);
        setResizable(false);
        setLayout(new GridLayout(3,2));

        add(btn,0);
        add(btn2, 1);
        add(btn3, 2);
        add(btn4, 3);

        addWindowListener(
                new WindowAdapter() {
                    @Override
                    public void windowClosing(WindowEvent e) {
                        System.exit(0);
                    }
                }
        );

        setVisible(true);
    }

    static void main(String[] args) {
        new Ventana3();
    }
}
